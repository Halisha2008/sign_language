import csv

input_file = 'sign_data.csv'
output_file = 'sign_data_cleaned.csv'

expected_columns = 43  # اسم الكلمة (1) + 42 نقطة لليد الواحدة (21 نقطة * 2 إحداثيات)

valid_rows = 0
deleted_rows = 0

with open(input_file, mode='r', encoding='utf-8') as infile, \
        open(output_file, mode='w', newline='', encoding='utf-8') as outfile:
    reader = csv.reader(infile)
    writer = csv.writer(outfile)

    for row in reader:
        # إذا كان عدد الأعمدة هو نفسه المطلوب (43)، نحفظ السطر
        if len(row) == 43 or len(row) == 85:
            writer.writerow(row)
            valid_rows += 1
        else:
            deleted_rows += 1

print(f"تم تنظيف الملف بنجاح!")
print(f"الأسطر السليمة التي تم الاحتفاظ بها: {valid_rows}")
print(f"الأسطر الخاطئة (التي تحتوي إيدين أو خطأ) التي تم حذفها: {deleted_rows}")
