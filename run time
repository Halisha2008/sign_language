import cv2
import mediapipe as mp
from mediapipe.tasks import python
from mediapipe.tasks.python import vision
import joblib
import numpy as np

# 1. تحميل النموذج المدرب الذي يحتوي على الكلمات الثلاثة
try:
    model = joblib.load('sign_language_model.pkl')
    print("تم تحميل النموذج بنجاح!")
except Exception as e:
    print("خطأ: لم يتم العثور على ملف النموذج. تأكد من تشغيل كود التدريب أولاً.")
    exit()

base_options = python.BaseOptions(model_asset_path="hand_landmarker.task")
options = vision.HandLandmarkerOptions(
    base_options=base_options,
    num_hands=2,
    running_mode=vision.RunningMode.VIDEO
)
detector = vision.HandLandmarker.create_from_options(options)

cap = cv2.VideoCapture(0)
timestamp_ms = 0

print("تشغيل الكاميرا... قف أمام الكاميرا وطبق إحدى الإشارات. اضغط 'Esc' للخروج.")

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    frame = cv2.flip(frame, 1)
    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)

    result = detector.detect_for_video(image=mp_image, timestamp_ms=timestamp_ms)
    timestamp_ms += 33

    frame_points = []

    if result and result.hand_landmarks:
        for hand in result.hand_landmarks:
            wrist = hand[0]
            wrist_x = wrist.x
            wrist_y = wrist.y

            for lm in hand:
                x, y = int(lm.x * frame.shape[1]), int(lm.y * frame.shape[0])
                cv2.circle(frame, (x, y), 4, (0, 255, 0), -1)

                normalized_x = lm.x - wrist_x
                normalized_y = lm.y - wrist_y

                frame_points.append(normalized_x)
                frame_points.append(normalized_y)

        # التنبؤ بالكلمة إذا تم رصد نقاط يد وحدة بدقة
        if len(frame_points) == 42:  # التأكد أنها يد واحدة (21 نقطة * 2)
            try:
                input_data = np.array([frame_points])

                # التنبؤ بالكلمة وحساب نسبة الثقة
                prediction = model.predict(input_data)[0]
                confidence = np.max(model.predict_proba(input_data)) * 100

                # عرض النتيجة على الشاشة
                text = f"Sign: {prediction} ({confidence:.1f}%)"
                cv2.putText(frame, text, (30, 50),
                            cv2.FONT_HERSHEY_SIMPLEX, 1.0, (0, 255, 0), 2)
            except Exception as e:
                pass
    else:
        cv2.putText(frame, 'No hand detected', (50, 50),
                    cv2.FONT_HERSHEY_SIMPLEX, 1.0, (0, 0, 255), 2)

    cv2.imshow('Sign Language Assistant - Syria', frame)

    if cv2.waitKey(1) & 0xFF == 27:  # زر ESC للإغلاق
        break

cap.release()
cv2.destroyAllWindows()
